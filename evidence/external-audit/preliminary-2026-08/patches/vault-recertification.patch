+        }
+        if (vault.pausedRedeem()) {
+            try vault.unpauseRedeem() {} catch {}
+        }
+        if (vault.pausedClaim()) {
+            try vault.unpauseClaim() {} catch {}
+        }
+        if (vault.pausedAllocation()) {
+            try vault.unpauseAllocation() {} catch {}
+        }
+        vm.stopPrank();
+    }
