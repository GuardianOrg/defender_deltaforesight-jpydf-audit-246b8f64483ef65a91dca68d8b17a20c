@@ -90,7 +90,7 @@ contract MockBO {
 }
 
 contract GuardianR2L01StrategyGasBudgetTest is Test {
-    uint256 internal constant PROBE_BUDGET = 500_000; // CollateralVault.STRATEGY_VALUATION_GAS
+    uint256 internal constant PROBE_BUDGET = 500_000; // CollateralVault default Strategy valuation gas budget
 
     MockERC20 internal underlying;
     GasHeavyERC4626Vault internal yieldVault;
@@ -319,4 +319,71 @@ contract GuardianR2L01StrategyGasBudgetTest is Test {
         assertLt(hi, used + PROBE_BUDGET * 64 / 63 + 150_000, "minimum gas limit drifted far above usage + budget");
         assertGt(hi, used + PROBE_BUDGET / 2, "pre-check no longer requires the probe budget");
     }
+
+    // ------------------------------------------------------------------ GOV-tunable budget
+
+    event StrategyValuationGasBudgetUpdated(uint256 oldBudget, uint256 newBudget);
+
+    uint256 internal constant GAS_BUDGET_SLOT = 321; // forge inspect CollateralVault storageLayout
+
+    function test_budgetDefaultsTo500k() public view {
+        assertEq(vault.strategyValuationGasBudget(), PROBE_BUDGET);
+    }
+
+    function test_setBudget_onlyGovWithinBounds() public {
+        vm.prank(attacker);
+        vm.expectRevert();
+        vault.setStrategyValuationGasBudget(1_000_000);
+
+        vm.expectRevert(abi.encodeWithSelector(CollateralVault.InvalidStrategyValuationGasBudget.selector, 99_999));
+        vault.setStrategyValuationGasBudget(99_999);
+        vm.expectRevert(abi.encodeWithSelector(CollateralVault.InvalidStrategyValuationGasBudget.selector, 2_000_001));
+        vault.setStrategyValuationGasBudget(2_000_001);
+
+        vm.expectEmit(address(vault));
+        emit StrategyValuationGasBudgetUpdated(PROBE_BUDGET, 1_000_000);
+        vault.setStrategyValuationGasBudget(1_000_000);
+        assertEq(vault.strategyValuationGasBudget(), 1_000_000);
+
+        vault.setStrategyValuationGasBudget(100_000);
+        vault.setStrategyValuationGasBudget(2_000_000);
+        assertEq(vault.strategyValuationGasBudget(), 2_000_000);
+    }
+
+    /// @dev An upgraded proxy whose new slot is still zero must keep the default budget,
+    ///      not probe with zero gas.
+    function test_unsetSlotBehavesAsDefault() public {
+        assertEq(uint256(vm.load(address(vault), bytes32(GAS_BUDGET_SLOT))), PROBE_BUDGET, "slot position");
+        vm.store(address(vault), bytes32(GAS_BUDGET_SLOT), bytes32(0));
+        assertEq(vault.strategyValuationGasBudget(), PROBE_BUDGET);
+        yieldVault.setBurnGas(300_000);
+        assertTrue(vault.refreshStrategyValuation(IStrategy(address(strategy))), "valuation still works");
+    }
+
+    /// @dev Raising the budget lets a Strategy whose valuation grew past the default be valued
+    ///      again, and the raised budget keeps the no-latch guarantee.
+    function test_raisedBudgetRestoresValuationAndKeepsNoLatch() public {
+        yieldVault.setBurnGas(800_000); // valuation cost grew beyond the default budget
+        assertFalse(vault.refreshStrategyValuation(IStrategy(address(strategy))), "over the default budget");
+
+        vault.setStrategyValuationGasBudget(1_200_000);
+        assertTrue(vault.refreshStrategyValuation(IStrategy(address(strategy))), "valued within the raised budget");
+
+        _expireValuationCache();
+        vm.startPrank(attacker);
+        _assertNoGasLatch(4_000_000, 300_000, 5_000);
+        vm.stopPrank();
+    }
+
+    /// @dev Lowering the budget below a Strategy's real cost makes it a genuine valuation
+    ///      failure (the monitoring case Guardian flagged); it is never a caller-gas artefact.
+    function test_budgetBelowStrategyCostIsGenuineFailure() public {
+        yieldVault.setBurnGas(300_000);
+        vault.setStrategyValuationGasBudget(200_000);
+        assertFalse(vault.refreshStrategyValuation(IStrategy(address(strategy))));
+        _expireValuationCache();
+        (, bool failure) = proxy.fetchPrice();
+        assertTrue(failure);
+        assertTrue(bo.shutDownCalled());
+    }
 }
