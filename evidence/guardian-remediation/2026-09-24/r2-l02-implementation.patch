+    mapping(bytes32 => bool) public exists;
+    error CampaignAlreadyExists();
+
+    function acceptConditions() external {}
+
+    function campaignId(CampaignParameters memory p) public view returns (bytes32) {
+        return keccak256(
+            abi.encodePacked(
+                block.chainid, p.creator, p.rewardToken, p.campaignType, p.startTimestamp, p.duration, p.campaignData
+            )
+        );
+    }
+
+    function createCampaign(CampaignParameters memory p) external returns (bytes32 id) {
+        // The real venue pulls tokens before its duplicate check; that pull must revert too.
+        IERC20(p.rewardToken).transferFrom(msg.sender, address(this), p.amount);
+        id = campaignId(p);
+        if (exists[id]) revert CampaignAlreadyExists();
+        exists[id] = true;
+    }
+}
