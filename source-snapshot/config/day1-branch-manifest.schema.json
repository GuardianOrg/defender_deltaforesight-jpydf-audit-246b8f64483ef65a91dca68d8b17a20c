{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deltaforesight/jpydf-v2/blob/develop/config/day1-branch-manifest.schema.json",
  "title": "JPYdf Day-1 Branch Owner Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "chainId", "totalBranches", "activeBranches", "branches"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "owner", "state", "approval"],
      "properties": {
        "record": { "const": "documents/jp/protocol/launch/decisions/Day1-Parameter-Decision.md" },
        "owner": { "type": "string", "minLength": 2 },
        "state": { "enum": ["Candidate", "Approved", "Deployed", "Verified"] },
        "approval": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["approvedAt", "commit"],
              "properties": {
                "approvedAt": { "type": "string", "format": "date" },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "Candidate" } }, "required": ["state"] },
          "then": { "properties": { "approval": { "type": "null" } } }
        },
        {
          "if": { "properties": { "state": { "enum": ["Approved", "Deployed", "Verified"] } }, "required": ["state"] },
          "then": { "properties": { "approval": { "type": "object" } } }
        }
      ]
    },
    "chainId": { "const": 1 },
    "totalBranches": { "const": 8 },
    "activeBranches": { "const": 2 },
    "branches": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/branch" }
    }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "slot", "state", "underlying", "priceFeed", "collateralYieldZapper", "nativeEthRoute", "strategyPolicy", "risk", "yieldLayer"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "slot": { "type": "string", "minLength": 2 },
        "state": { "enum": ["active", "inert"] },
        "underlying": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbol", "address"],
              "properties": {
                "symbol": { "type": "string", "minLength": 2 },
                "address": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{40}$" }
              }
            }
          ]
        },
        "priceFeed": { "type": "string", "minLength": 2 },
        "collateralYieldZapper": { "type": "boolean" },
        "nativeEthRoute": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["expectedStEth", "lidoReferral"],
              "properties": {
                "expectedStEth": { "$ref": "#/$defs/address" },
                "lidoReferral": { "$ref": "#/$defs/address" }
              }
            }
          ]
        },
        "strategyPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "allowed"],
          "properties": {
            "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "allowed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lltv", "mcr", "ccr", "scr", "bcr", "spPenalty", "redistributionPenalty"],
          "properties": {
            "lltv": { "$ref": "#/$defs/decimal" },
            "mcr": { "$ref": "#/$defs/decimal" },
            "ccr": { "$ref": "#/$defs/decimal" },
            "scr": { "$ref": "#/$defs/decimal" },
            "bcr": { "$ref": "#/$defs/decimal" },
            "spPenalty": { "$ref": "#/$defs/decimal" },
            "redistributionPenalty": { "$ref": "#/$defs/decimal" }
          }
        },
        "yieldLayer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mintCapJpy", "allocatorCooldownSeconds", "allocateMaxMoveJpy", "withdrawDelaySeconds", "bufferTargetBps", "bufferFloor"],
          "properties": {
            "mintCapJpy": { "$ref": "#/$defs/integerString" },
            "allocatorCooldownSeconds": { "type": "integer", "minimum": 0 },
            "allocateMaxMoveJpy": { "$ref": "#/$defs/integerString" },
            "withdrawDelaySeconds": { "type": "integer", "minimum": 0 },
            "bufferTargetBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "bufferFloor": { "$ref": "#/$defs/integerString" }
          }
        }
      }
    },
    "address": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{40}$" },
    "decimal": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "integerString": { "type": "string", "pattern": "^[0-9]+$" }
  }
}
